# Copie para .env e preencha. O .env NUNCA vai para o git.
#
# Este arquivo existe só para a conveniência de quem opera: os scripts de start
# carregam estas variáveis no ambiente do processo. O integrador em si lê apenas
# variáveis de ambiente — ele nunca abre o .env por conta própria.

# Token do API Server do Holyrics. Obrigatório.
# No Holyrics: Arquivo > Configurações > API Server.
HOLYRICS_TOKEN=

# Nível de log. Opcional — sobrepõe log.nivel do config.json.
# Use debug para calibrar a região de cor e o limiar; deixa uma linha por
# leitura, o que enche o arquivo depressa.
# LOG_LEVEL=debug

# Caminho alternativo do arquivo de configuração. Opcional.
# CONFIG_PATH=./config/config.json
